# Copia este archivo a .env y ajusta los valores.
# Docker Compose carga .env automáticamente desde este directorio, así que
# `docker compose up` tomará estas variables sin exportarlas en el shell.
#
# El archivo .env está en .gitignore: NO lo subas al repositorio.

# --- Inferencia por IA (opcional) ---
# Proveedor de IA. Vacío => la inferencia por IA se omite. Usa "groq" para activarla.
AI_PROVIDER=groq

# Clave de API de Groq (requerida si AI_PROVIDER=groq). Obtenla en GroqCloud.
GROQ_API_KEY=tu_clave_de_groq

# Modelo de Groq a usar (opcional). Debe estar habilitado en tu organización.
GROQ_MODEL=openai/gpt-oss-120b

# --- Base de datos PostgreSQL ---
# Credenciales de PostgreSQL. Se usan tanto para crear la BD (servicio db) como
# para construir la DATABASE_URL del backend. Cambia la contraseña en entornos
# que no sean puramente locales.
POSTGRES_USER=repo_analyzer
POSTGRES_PASSWORD=repo_analyzer
POSTGRES_DB=repo_analyzer

# Puerto del host donde se publica PostgreSQL (para clientes gráficos como
# DBeaver/TablePlus). Conéctate a localhost:este_puerto. Cambia el valor si el
# 5432 ya está ocupado en tu máquina.
POSTGRES_PORT=5432
